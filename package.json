{
  "name": "pumpfun-migration-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "bot": "npm run build && node dist/bot.js",
    "chat-id": "npm run build && node dist/get-chat-id.js",
