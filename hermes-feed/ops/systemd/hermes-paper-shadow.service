[Unit]
Description=Hermes extended read-only NOXA paper shadow runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/srv/codex-workspaces/pumpfunnoti/hermes-feed/target/release/hermes-noxa-runtime --mode paper --recipient 0xd7A41D7E502F5D63B36Ec59c84F59A3eFA6B99a0 --run-seconds 1800 --warmup-seconds 5
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
InaccessiblePaths=/srv/codex-workspaces/hermes-secrets

[Install]
WantedBy=default.target
