TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_CHAT_ID=123456789
TELEGRAM_VERIFY_CODE=replace_with_private_invite_code
TELEGRAM_SUBSCRIBERS_PATH=data/telegram-subscribers.json
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# PumpPortal docs show the API key on the websocket URL.
# subscribeMigration is free, but keep the key here for compatibility.
PUMPPORTAL_API_KEY=replace_with_pumpportal_key
PUMPPORTAL_TRADE_LOCAL_URL=https://pumpportal.fun/api/trade-local
PUMPPORTAL_CREATE_WALLET_URL=https://pumpportal.fun/api/create-wallet
PUMPPORTAL_LIGHTNING_TRADE_URL=https://pumpportal.fun/api/trade
PUMPPORTAL_WALLET_KEY_ENCRYPTION_SECRET=replace_with_32_plus_character_random_secret
COPY_TRADE_ENABLED=false
COPY_TRADE_DRY_RUN=true
# pumpportal = PumpPortal only; parallel = PumpPortal + Geyser; shredstream = PumpPortal + ShredStream; all = all available feeds.
COPY_TRADE_SIGNAL_PROVIDER=pumpportal
COPY_TRADE_SLIPPAGE=10
COPY_TRADE_PRIORITY_FEE=0.00005
COPY_TRADE_POOL=auto
COPY_TRADE_MAX_BUY_SOL=0
COPY_TRADE_DAILY_SOL_CAP=0
COPY_TRADE_BUY_IDEMPOTENCY_PATH=data/copytrade-buy-idempotency.json
COPY_TRADE_MAX_SIGNAL_AGE_MS=0
COPY_TRADE_MAX_SLIPPAGE=0
COPY_TRADE_MAX_PRIORITY_FEE=0
COPY_TRADE_MAX_COPY_WALLETS_PER_CHAT=0
COPY_TRADE_ALLOWED_SOURCES=
COPY_TRADE_MIN_WALLET_RESERVE_SOL=0
COPY_TRADE_TRAILING_SELL_ENABLED=false
COPY_TRADE_TRAILING_SELL_HOLD_MS=2000
COPY_TRADE_TRAILING_SELL_FIRST_PERCENT=20
COPY_TRADE_TRAILING_SELL_TRAIL_PERCENT=20
COPY_TRADE_TRAILING_SELL_INTERVAL_MS=2000
COPY_TRADE_TRAILING_SELL_MAX_BUILDS=5
DIRECT_EXECUTION_BLOCKHASH_CACHE_MS=15000
DIRECT_EXECUTION_BLOCKHASH_WARM_INTERVAL_MS=5000
DIRECT_EXECUTION_SDK_WARM_INTERVAL_MS=30000
DIRECT_EXECUTION_SIMULATE_BEFORE_SEND=true
DIRECT_EXECUTION_SKIP_PREFLIGHT=false
DIRECT_EXECUTION_MAX_RETRIES=3
DIRECT_EXECUTION_SEND_RPC_URLS=
DIRECT_EXECUTION_JITO_SEND_URLS=
DIRECT_EXECUTION_JITO_AUTH_UUID=
PLATFORM_FEE_ENABLED=false
PLATFORM_FEE_BPS=100
PLATFORM_FEE_TREASURY=

# Optional
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
SOLSCAN_BASE_URL=https://solscan.io
PUMPFUN_BASE_URL=https://pump.fun
PUMPFUN_COIN_API_BASE_URL=https://frontend-api-v3.pump.fun/coins
MIGRATION_LOG_PATH=logs/migrations.jsonl
WALLET_TRADE_LOG_PATH=logs/wallet-trades.jsonl
WALLET_FEED_DIAGNOSTIC_WALLETS=
SHREDSTREAM_COMPARE_ENABLED=false
SHREDSTREAM_WALLET_OBSERVER_ENABLED=false
SHREDSTREAM_WALLET_OBSERVER_STATS_INTERVAL_MS=60000
PUMPPORTAL_DISCOVERY_LOG_PATH=logs/pumpportal-discovery-events.jsonl
COPY_TRADE_EMERGENCY_STOP_PATH=data/copytrade-emergency-stop.json
CASHBACK_ENABLED=false
CASHBACK_FEE_SHARE_BPS=4000
CASHBACK_MIN_CLAIM_SOL=0.001
CASHBACK_MAX_PAYOUT_SOL_PER_DAY=0
CASHBACK_PAYOUT_WALLET_PUBLIC_KEY=
CASHBACK_PAYOUT_WALLET_SECRET_KEY=

# Optional post-submit bridge for Rust copy buys. Keeps the Rust buy transaction untouched:
# Node sees the submitted Rust buy row, sends a separate fee transfer, then makes cashback claimable after confirmation.
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_ENABLED=false
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_ALLOW_ALL_CHATS=false
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_CANARY_CHAT_IDS=
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_CANARY_WALLETS=
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_SOURCE=local-jsonl
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_LOCAL_EXECUTIONS_PATH=/var/log/jito-copy-executions-vps.jsonl
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_POLL_MS=1000
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_LOOKBACK_MS=60000
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_STARTUP_LOOKBACK_MS=0
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_MAX_ROWS=50
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_MAX_ATTEMPTS=3
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_CONFIRMATION_TIMEOUT_MS=30000
COPY_TRADE_RUST_ASYNC_PLATFORM_FEE_CONFIRMATION_POLL_MS=2000

# Optional post-submit Telegram alerts for Rust copy buys. Prefer local JSONL to avoid recurring Supabase reads.
COPY_TRADE_RUST_EXECUTION_ALERTS_ENABLED=false
COPY_TRADE_RUST_EXECUTION_ALERTS_SOURCE=local-jsonl
COPY_TRADE_RUST_EXECUTION_ALERTS_LOCAL_EXECUTIONS_PATH=/var/log/jito-copy-executions-vps.jsonl
COPY_TRADE_RUST_EXECUTION_ALERTS_POLL_MS=1000
COPY_TRADE_RUST_EXECUTION_ALERTS_LOOKBACK_MS=60000
COPY_TRADE_RUST_EXECUTION_ALERTS_STARTUP_LOOKBACK_MS=0
COPY_TRADE_RUST_EXECUTION_ALERTS_MAX_ROWS=50
HELIUS_API_KEY=replace_with_helius_key
HELIUS_API_BASE_URL=https://api-mainnet.helius-rpc.com
HELIUS_WEBHOOK_PUBLIC_URL=https://your-domain.example/webhooks/helius
HELIUS_WEBHOOK_AUTH_HEADER=Bearer replace_with_long_random_secret
HELIUS_WEBHOOK_ID=
HELIUS_WEBHOOK_STATE_PATH=data/helius-webhook.json

# Optional low-latency Yellowstone/gRPC wallet-trade stream.
# QuickNode format:
#   YELLOWSTONE_ENDPOINT=https://your-endpoint.solana-mainnet.quiknode.pro:10000
#   YELLOWSTONE_TOKEN=token_from_the_original_quicknode_rpc_url
YELLOWSTONE_ENABLED=false
YELLOWSTONE_ENDPOINT=
YELLOWSTONE_TOKEN=
YELLOWSTONE_COMMITMENT=processed
YELLOWSTONE_SHADOW_ONLY=true
YELLOWSTONE_RECONNECT_MS=2000
WEBHOOK_PORT=3000
SOL_USD_PRICE_URL=https://api.coinbase.com/v2/prices/SOL-USD/spot
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
GEYSER_ENABLED=false
GEYSER_GRPC_URL=http://va.pixellabz.io:9000
GEYSER_X_TOKEN=
TRANSACTION_FLOW_ENABLED=true
# Optional JSON map for labeling known fee/cashback/wallet addresses.
# Example: {"WalletAddressHere":"Cashback fee","AnotherWallet":"Wallet fee"}
TRANSACTION_ACCOUNT_LABELS=

# Optional observe-only ShredStream discovery comparison.
# Run the Jito proxy separately, then start the standalone listener with these.
SHREDSTREAM_DISCOVERY_ENABLED=false
SHREDSTREAM_SOURCE=grpc
SHREDSTREAM_GRPC_URL=127.0.0.1:9999
SHREDSTREAM_EVENT_LOG_PATH=logs/shred-pump-events.jsonl
SHREDSTREAM_DECODER_CMD=tools/shredstream-rs/target/release/shredstream-rs watch --grpc-url {grpcUrl}
