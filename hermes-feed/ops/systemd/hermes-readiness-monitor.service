[Unit]
Description=Hermes read-only NOXA and Robinhood testnet readiness monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/srv/codex-workspaces/pumpfunnoti/hermes-feed/target/release/hermes-readiness-monitor --interval-seconds 300
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
InaccessiblePaths=/srv/codex-workspaces/hermes-secrets

[Install]
WantedBy=default.target
