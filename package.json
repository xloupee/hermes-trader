{
  "name": "pumpfun-migration-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "bot": "npm run build && node dist/bot.js",
    "shred-listener": "npm run build && node dist/shred-listener.js",
    "chat-id": "npm run build && node dist/get-chat-id.js",
    "past-migrations": "npm run build && node dist/past-migrations.js",
    "import-subscribers": "npm run build && node dist/import-subscribers.js",
    "shredstream-decoder:check": "cargo check --manifest-path tools/shredstream-rs/Cargo.toml",
    "shredstream-decoder:test": "cargo test --manifest-path tools/shredstream-rs/Cargo.toml",
    "shredstream-latency-report": "npm run build && node scripts/compare-shredstream-discovery-latency.mjs",
    "shredstream-promotion-gate": "node scripts/shredstream-promotion-gate.mjs",
    "shredstream-wallet-coverage-report": "node scripts/shredstream-wallet-coverage-report.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "wallet-feed-readiness-report": "node scripts/wallet-feed-readiness-report.mjs",
    "wallet-feed-report": "node scripts/wallet-feed-comparison-report.mjs",
    "stop-local": "bash scripts/stop-local.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "^1.36.0",
    "@pump-fun/pump-swap-sdk": "^1.17.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.106.1",
    "@triton-one/yellowstone-grpc": "^5.0.8",
    "bn.js": "^5.2.3",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3"
  }
}
