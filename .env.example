TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_CHAT_ID=123456789
TELEGRAM_VERIFY_CODE=replace_with_private_invite_code
TELEGRAM_SUBSCRIBERS_PATH=data/telegram-subscribers.json
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# PumpPortal docs show the API key on the websocket URL.
# subscribeMigration is free, but keep the key here for compatibility.
PUMPPORTAL_API_KEY=replace_with_pumpportal_key
PUMPPORTAL_TRADE_LOCAL_URL=https://pumpportal.fun/api/trade-local
PUMPPORTAL_CREATE_WALLET_URL=https://pumpportal.fun/api/create-wallet
PUMPPORTAL_LIGHTNING_TRADE_URL=https://pumpportal.fun/api/trade
PUMPPORTAL_WALLET_KEY_ENCRYPTION_SECRET=replace_with_32_plus_character_random_secret
COPY_TRADE_ENABLED=false
COPY_TRADE_DRY_RUN=true
COPY_TRADE_SLIPPAGE=10
COPY_TRADE_PRIORITY_FEE=0.00005
COPY_TRADE_POOL=auto
COPY_TRADE_MAX_BUY_SOL=0.005
COPY_TRADE_DAILY_SOL_CAP=0.02
COPY_TRADE_MAX_SIGNAL_AGE_MS=60000
COPY_TRADE_MAX_SLIPPAGE=15
COPY_TRADE_MAX_PRIORITY_FEE=0.0002
COPY_TRADE_MAX_COPY_WALLETS_PER_CHAT=1
COPY_TRADE_ALLOWED_SOURCES=
COPY_TRADE_MIN_WALLET_RESERVE_SOL=0
COPY_TRADE_TRAILING_SELL_ENABLED=false
COPY_TRADE_TRAILING_SELL_HOLD_MS=2000
COPY_TRADE_TRAILING_SELL_FIRST_PERCENT=20
COPY_TRADE_TRAILING_SELL_TRAIL_PERCENT=20
COPY_TRADE_TRAILING_SELL_INTERVAL_MS=2000
COPY_TRADE_TRAILING_SELL_MAX_BUILDS=5

# Optional
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
SOLSCAN_BASE_URL=https://solscan.io
PUMPFUN_BASE_URL=https://pump.fun
PUMPFUN_COIN_API_BASE_URL=https://frontend-api-v3.pump.fun/coins
MIGRATION_LOG_PATH=logs/migrations.jsonl
WALLET_TRADE_LOG_PATH=logs/wallet-trades.jsonl
COPY_TRADE_EMERGENCY_STOP_PATH=data/copytrade-emergency-stop.json
HELIUS_API_KEY=replace_with_helius_key
HELIUS_API_BASE_URL=https://api-mainnet.helius-rpc.com
HELIUS_WEBHOOK_PUBLIC_URL=https://your-domain.example/webhooks/helius
HELIUS_WEBHOOK_AUTH_HEADER=Bearer replace_with_long_random_secret
HELIUS_WEBHOOK_ID=
HELIUS_WEBHOOK_STATE_PATH=data/helius-webhook.json
WEBHOOK_PORT=3000
SOL_USD_PRICE_URL=https://api.coinbase.com/v2/prices/SOL-USD/spot
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TRANSACTION_FLOW_ENABLED=true
# Optional JSON map for labeling known fee/cashback/wallet addresses.
# Example: {"WalletAddressHere":"Cashback fee","AnotherWallet":"Wallet fee"}
TRANSACTION_ACCOUNT_LABELS=
