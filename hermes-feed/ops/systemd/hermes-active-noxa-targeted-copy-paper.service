ExecStart=/srv/codex-workspaces/pumpfunnoti/hermes-feed/target/release/hermes-noxa-runtime --mode paper --deployment active-noxa --strategy copy --recipient 0xd7A41D7E502F5D63B36Ec59c84F59A3eFA6B99a0 --watch-wallet-file /srv/codex-workspaces/pumpfunnoti/.runtime/hermes-copy/verified-noxa-wallets.txt --copy-token 0xb4d560a2e300255dd4f5a92e55321dec41cebca4 --copy-token 0x24802ff6a9909288811ba95f50514f08f11ba1e6 --copy-token 0xa1f3dc500a92898faeb2da7229ecc2c9866d17e5 --run-seconds 3600 --warmup-seconds 5 --copy-max-triggers 100 --slippage-bps 100 --max-slippage-bps 100
