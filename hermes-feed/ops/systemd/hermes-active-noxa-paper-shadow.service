[Unit]
Description=Hermes active N0xa launch paper shadow (no signing or broadcast)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/codex-workspaces/pumpfunnoti/hermes-feed
ExecStart=/srv/codex-workspaces/pumpfunnoti/hermes-feed/target/release/hermes-noxa-runtime --mode paper --deployment active-noxa --strategy launch --recipient 0xd7A41D7E502F5D63B36Ec59c84F59A3eFA6B99a0 --run-seconds 600 --warmup-seconds 5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=/srv/codex-workspaces/hermes-secrets

[Install]
WantedBy=default.target
